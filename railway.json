{
  "project": {
    "name": "RisnaScrapbook"
  },
  "services": [
    {
      "name": "api-server",
      "startCommand": "pnpm --filter ./artifacts/api-server start",
      "path": "./artifacts/api-server",
      "env": {
        "PORT": "3000"
      }
    }
    ,
    {
      "name": "web",
      "startCommand": "pnpm --filter ./artifacts/special-message serve",
      "path": "./artifacts/special-message",
      "env": {
        "PORT": "3001"
      }
    }
  ]
}
